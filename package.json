{
  "name": "simulador-procesos-memoria",
  "version": "1.0.0",
  "description": "Biblioteca de clases que simula procesos, memoria contigua y planificación Round-Robin (AE2 Paradigmas II - UCP 2026)",
  "private": true,
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
