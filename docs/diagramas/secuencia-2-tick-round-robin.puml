@startuml secuencia-2-tick-round-robin
title Secuencia 2 - RF06/RF07: un tick de Round-Robin
autonumber
actor Test
participant ":Simulador" as S
participant ":PlanificadorRoundRobin" as PL
participant "p:Proceso" as P
participant "regla:IReglaCpu" as R
participant ":AdministradorMemoria" as M
participant ":Metricas" as MT

Test -> S : avanzarTick()
S -> S : admitirProcesos()
S -> PL : actualizarBloqueados()
S -> PL : ejecutarTick()
PL -> PL : despacharSiLaCpuEstaLibre()
note right of PL : toma de la cola\n(1 - procesos en CPU) procesos
opt la CPU estaba libre
  PL -> P : despachar()
end
PL -> P : ejecutarUnaUnidad()
PL -> PL : ejecutar(p)
loop reglas en orden: Finalizacion, EntradaSalida, QuantumAgotado, Continuar
  PL -> R : aplica(p, this)
end
note right of R : se usa la PRIMERA que devuelve true\n(polimorfismo, sin if)
PL -> R : aplicar(p, this)
alt ReglaFinalizacion
  R -> P : terminar()
  R -> PL : liberarCpu()
else ReglaQuantumAgotado (hay otros listos)
  R -> P : expulsar()
  R -> PL : liberarCpu()
  R -> PL : encolar(p)
else ReglaContinuar
  R -> P : renovarQuantum(quantum)
end
R --> PL : ResultadoTick
PL --> S : ResultadoTick
S -> M : liberar(pid) por cada terminado
M -> M : coalescencia()
S -> MT : registrarTick(resultado)
S -> S : setTick(getTick() + 1)
S -> MT : recalcular(memoria, tick)
@enduml
