@startuml secuencia-1-admision-memoria
title Secuencia 1 - RF03/RF04: admisión y asignación de memoria (fase 1 del tick)
autonumber
actor Test
participant ":Simulador" as S
participant "p:Proceso" as P
participant "estado:Nuevo" as E
participant ":AdministradorMemoria" as M
participant "politica:PrimerAjuste" as POL
participant "bloque:BloqueMemoria" as B
participant ":PlanificadorRoundRobin" as PL

Test -> S : registrarProceso("P1", 200, 4)
S -> P ** : new Proceso("P1", 200, 4)
P -> E ** : new Nuevo()
S --> Test : DatosProceso (NUEVO)

Test -> S : avanzarTick()
S -> S : admitirProcesos()
S -> P : estaPendienteDeMemoria()
P -> E : estaPendienteDeMemoria()
E --> P : true
S -> M : asignar("P1", 200)
M -> POL : elegir(bloques, 200)
POL -> POL : ordenar(candidatos) <<override>>
POL --> M : [bloque] o [ ]
alt la política devolvió [bloque]
  M -> M : ocupar(bloque, "P1", 200)
  M -> B : recortarA(200)
  M -> B : asignarA("P1")
  M -> M : setBloques(...) verifica invariantes
  M --> S : true
  S -> P : admitir()
  P -> E : admitir()
  E --> P : new Listo()
  S -> PL : encolar(p)
else la política devolvió [ ]
  M --> S : false (no modifica nada)
  S -> P : esperarMemoria()
  P -> E : esperarMemoria()
  E --> P : new EsperandoMemoria()
end
@enduml
