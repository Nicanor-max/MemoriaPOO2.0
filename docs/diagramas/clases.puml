@startuml clases
!pragma layout smetana
title Simulador de procesos y memoria - Diagrama de clases
skinparam classAttributeIconSize 0
skinparam shadowing false
hide empty members
left to right direction

' Las referencias a otros objetos NO se listan como atributos:
' se dibujan como relaciones con rol y multiplicidad.

package comun {
  class Error
  class ErrorDeDominio
  interface "IImprimible<T>" as IImprimible {
    +estado(): T
  }
}

package procesos {
  interface IProcesoConsultable {
    +getPid(): string
    +getMemoriaRequerida(): number
    +getCpuRestante(): number
    +getNombreEstado(): string
    +estaPendienteDeMemoria(): boolean
    +haFinalizadoSuCpu(): boolean
    +agotoQuantum(quantum): boolean
    +debeBloquearse(): boolean
  }
  interface IProcesoCicloDeVida {
    +admitir(): void
    +esperarMemoria(): void
    +despachar(): void
    +ejecutarUnaUnidad(): void
    +renovarQuantum(quantum): void
    +expulsar(): void
    +terminar(): void
  }
  interface IProcesoEntradaSalida {
    +programarEntradaSalida(ticksDeCpu, duracion): void
    +bloquear(): void
    +avanzarBloqueo(): boolean
    +desbloquear(): void
  }
  interface IProcesoPlanificable

  class Proceso {
    -_pid: string
    -_memoriaRequerida: number
    -_cpuTotal: number
    -_cpuRestante: number
    -_quantumConsumido: number
    -_bloqueoRestante: number
    +Proceso(pid, memoriaRequerida, cpuTotal)
    +getPid() / -setPid(valor)
    +getCpuRestante() / -setCpuRestante(valor)
    +getQuantumConsumido() / -setQuantumConsumido(valor)
    +getBloqueoRestante() / -setBloqueoRestante(valor)
    -getEstado() / -setEstado(valor)
    -getEntradaSalida() / -setEntradaSalida(valor)
    +estado(): DatosProceso
  }

  interface IEstadoProceso {
    +getNombre(): string
    +estaPendienteDeMemoria(): boolean
    +admitir(): IEstadoProceso
    +despachar(): IEstadoProceso
    +ejecutar(): IEstadoProceso
    +expulsar(): IEstadoProceso
    +bloquear(): IEstadoProceso
    +desbloquear(): IEstadoProceso
    +terminar(): IEstadoProceso
  }
  abstract class EstadoProceso {
    -_nombre: string
    #EstadoProceso(nombre)
    +getNombre(): string
    -setNombre(valor): void
    +admitir(): IEstadoProceso
    +despachar(): IEstadoProceso
    +...(): transición inválida por defecto
    #transicionInvalida(accion): never
  }
  class Nuevo {
    +estaPendienteDeMemoria() <<override>>
    +admitir() <<override>>
    +esperarMemoria() <<override>>
  }
  class EsperandoMemoria {
    +estaPendienteDeMemoria() <<override>>
    +admitir() <<override>>
    +esperarMemoria() <<override>>
  }
  class Listo {
    +despachar() <<override>>
  }
  class Ejecutando {
    +ejecutar() <<override>>
    +expulsar() <<override>>
    +bloquear() <<override>>
    +terminar() <<override>>
  }
  class Bloqueado {
    +avanzarBloqueo() <<override>>
    +desbloquear() <<override>>
  }
  class Terminado {
    +permiteProgramarEntradaSalida() <<override>>
  }

  interface IEntradaSalida {
    +estaProgramada(): boolean
    +correspondeDispararEn(cpuConsumida): boolean
    +getDuracion(): number
  }
  class EntradaSalida {
    -_ticksDeCpu: number
    -_duracion: number
    +getTicksDeCpu() / -setTicksDeCpu(valor)
    +getDuracion() / -setDuracion(valor)
  }
  class SinEntradaSalida <<objeto nulo>>
}

package memoria {
  interface IAsignadorMemoria {
    +asignar(pid, tamanio): boolean
  }
  interface ILiberadorMemoria {
    +liberar(pid): void
  }
  interface IConsultaMemoria {
    +getMemoriaTotal(): number
    +getMemoriaLibreTotal(): number
    +getMayorBloqueLibre(): number
    +consultarMapa(): DatosBloque[]
  }
  class AdministradorMemoria {
    -_memoriaTotal: number
    +AdministradorMemoria(memoriaTotal, politica)
    +getMemoriaTotal() / -setMemoriaTotal(valor)
    -getPolitica() / -setPolitica(valor)
    -getBloques() / -setBloques(valor)
    -ocupar(bloque, pid, tamanio): void
    -coalescencia(): void
    -verificarInvariantes(bloques): void
  }
  interface IBloqueConsultable {
    +getInicio(): number
    +getTamanio(): number
    +getPidAsignado(): string
    +estaLibre(): boolean
  }
  interface IBloqueModificable {
    +asignarA(pid): void
    +liberar(): void
    +recortarA(tamanio): void
  }
  class BloqueMemoria {
    -_inicio: number
    -_tamanio: number
    -_pidAsignado: string | null
    +getInicio() / -setInicio(valor)
    +getTamanio() / -setTamanio(valor)
    +getPidAsignado() / -setPidAsignado(valor)
  }
  interface IPoliticaAsignacion {
    +getNombre(): string
    +elegir(bloques, tamanio): IBloqueConsultable[]
  }
  abstract class PoliticaAsignacion {
    -_nombre: string
    +getNombre() / -setNombre(valor)
    +elegir(bloques, tamanio): IBloqueConsultable[]
    #{abstract} ordenar(candidatos): IBloqueConsultable[]
  }
  class PrimerAjuste {
    #ordenar(candidatos) <<override>>
  }
  class MejorAjuste {
    #ordenar(candidatos) <<override>>
  }
  class PeorAjuste {
    #ordenar(candidatos) <<override>>
  }
}

package planificacion {
  interface IPlanificador {
    +encolar(proceso): void
    +actualizarBloqueados(): void
    +ejecutarTick(): ResultadoTick
  }
  interface IConsultaPlanificador {
    +consultarProcesoEnCpu(): DatosProceso
    +consultarColaListos(): DatosProceso[]
    +consultarHistorialEjecucion(): string[]
  }
  interface IControlCpu {
    +getQuantum(): number
    +hayProcesosListos(): boolean
    +liberarCpu(): void
    +encolar(proceso): void
    +agregarBloqueado(proceso): void
  }
  class PlanificadorRoundRobin {
    -_quantum: number
    -_historialEjecucion: string[]
    +getQuantum() / -setQuantum(valor)
    -getColaListos() / -setColaListos(valor)
    -getCpu() / -setCpu(valor)
    -getBloqueados() / -setBloqueados(valor)
    -getReglas() / -setReglas(valor)
    -despacharSiLaCpuEstaLibre(): void
    -ejecutar(proceso): ResultadoTick
  }
  interface IReglaCpu {
    +aplica(proceso, cpu): boolean
    +aplicar(proceso, cpu): ResultadoTick
  }
  class ReglaFinalizacion
  class ReglaEntradaSalida
  class ReglaQuantumAgotado
  class ReglaContinuar
}

package metricas {
  interface IRegistroMetricas {
    +registrarTick(resultado): void
    +recalcular(memoria, ticks): void
  }
  interface IConsultaMetricas {
    +getUtilizacionCpu(): number
    +getCambiosDeContexto(): number
    +getFragmentacionExterna(): number
  }
  class Metricas {
    -_ticksConCpuOcupada: number
    -_cambiosDeContexto: number
    -_ocupacionMemoria: number
    -_utilizacionCpu: number
    -_memoriaLibreTotal: number
    -_mayorBloqueLibre: number
    -_fragmentacionExterna: number
    +get...() / -set...(valor)
  }
}

interface ISimulador {
  +registrarProceso(pid, memoriaRequerida, cpuTotal): DatosProceso
  +programarEntradaSalida(pid, ticksDeCpu, duracion): void
  +avanzarTick(): void
  +avanzarTicks(cantidad): void
}
interface IConsultaSimulador {
  +getTick(): number
  +consultarProceso(pid): DatosProceso
  +consultarColaListos(): DatosProceso[]
  +consultarMapaMemoria(): DatosBloque[]
  +consultarMetricas(): DatosMetricas
  +...
}
class Simulador {
  -_tick: number
  +Simulador(memoriaTotal = 1024, quantum = 2, politica = PrimerAjuste)
  +getTick() / -setTick(valor)
  -getProcesos() / -setProcesos(valor)
  -getMemoria() / -setMemoria(valor)
  -getPlanificador() / -setPlanificador(valor)
  -getMetricas() / -setMetricas(valor)
  -admitirProcesos(): void
  +estado(): DatosSimulador
}

' ---------------- Herencia ("es un") ----------------
ErrorDeDominio --|> Error
Nuevo --|> EstadoProceso
EsperandoMemoria --|> EstadoProceso
Listo --|> EstadoProceso
Ejecutando --|> EstadoProceso
Bloqueado --|> EstadoProceso
Terminado --|> EstadoProceso
PrimerAjuste --|> PoliticaAsignacion
MejorAjuste --|> PoliticaAsignacion
PeorAjuste --|> PoliticaAsignacion
IProcesoPlanificable --|> IProcesoConsultable
IProcesoPlanificable --|> IProcesoCicloDeVida
IProcesoPlanificable --|> IProcesoEntradaSalida
IProcesoPlanificable --|> IImprimible

' ---------------- Realización ----------------
Proceso ..|> IProcesoConsultable
Proceso ..|> IProcesoCicloDeVida
Proceso ..|> IProcesoEntradaSalida
Proceso ..|> IImprimible
EstadoProceso ..|> IEstadoProceso
EntradaSalida ..|> IEntradaSalida
EntradaSalida ..|> IImprimible
SinEntradaSalida ..|> IEntradaSalida
SinEntradaSalida ..|> IImprimible
AdministradorMemoria ..|> IAsignadorMemoria
AdministradorMemoria ..|> ILiberadorMemoria
AdministradorMemoria ..|> IConsultaMemoria
AdministradorMemoria ..|> IImprimible
BloqueMemoria ..|> IBloqueConsultable
BloqueMemoria ..|> IBloqueModificable
BloqueMemoria ..|> IImprimible
PoliticaAsignacion ..|> IPoliticaAsignacion
PlanificadorRoundRobin ..|> IPlanificador
PlanificadorRoundRobin ..|> IConsultaPlanificador
PlanificadorRoundRobin ..|> IControlCpu
PlanificadorRoundRobin ..|> IImprimible
ReglaFinalizacion ..|> IReglaCpu
ReglaEntradaSalida ..|> IReglaCpu
ReglaQuantumAgotado ..|> IReglaCpu
ReglaContinuar ..|> IReglaCpu
Metricas ..|> IRegistroMetricas
Metricas ..|> IConsultaMetricas
Metricas ..|> IImprimible
Simulador ..|> ISimulador
Simulador ..|> IConsultaSimulador
Simulador ..|> IImprimible

' ---------------- Composición y asociaciones ----------------
Simulador "1" *-- "0..*" IProcesoPlanificable : -_procesos {orden de registro}
Simulador "1" *-- "1" AdministradorMemoria : -_memoria
Simulador "1" *-- "1" PlanificadorRoundRobin : -_planificador
Simulador "1" *-- "1" Metricas : -_metricas
Proceso "1" --> "1" IEstadoProceso : -_estado
Proceso "1" --> "1" IEntradaSalida : -_entradaSalida
AdministradorMemoria "1" *-- "1..*" BloqueMemoria : -_bloques {ordenados por inicio}
AdministradorMemoria "1" --> "1" IPoliticaAsignacion : -_politica
PlanificadorRoundRobin "1" --> "0..*" IProcesoPlanificable : -_colaListos {FIFO}
PlanificadorRoundRobin "1" --> "0..1" IProcesoPlanificable : -_cpu
PlanificadorRoundRobin "1" --> "0..*" IProcesoPlanificable : -_bloqueados
PlanificadorRoundRobin "1" *-- "4" IReglaCpu : -_reglas {ordenadas por prioridad}
Metricas ..> IConsultaMemoria : <<usa>>
IReglaCpu ..> IControlCpu : <<usa>>
@enduml
