@startuml secuencia-3-bloqueo-entrada-salida
title Secuencia 3 - RF08: bloqueo por E/S y retorno a listos
autonumber
actor Test
participant ":Simulador" as S
participant "p:Proceso" as P
participant "es:EntradaSalida" as ES
participant ":PlanificadorRoundRobin" as PL
participant "regla:ReglaEntradaSalida" as R
participant ":Metricas" as MT

Test -> S : programarEntradaSalida("P1", 1, 2)
S -> P : programarEntradaSalida(1, 2)
P -> ES ** : new EntradaSalida(1, 2)
note right of P : reemplaza a SinEntradaSalida

== Tick N: se dispara la E/S ==
Test -> S : avanzarTick()
S -> PL : ejecutarTick()
PL -> P : ejecutarUnaUnidad()
PL -> R : aplica(p, this)
R -> P : debeBloquearse()
P -> ES : correspondeDispararEn(1)
ES --> P : true
R --> PL : true
PL -> R : aplicar(p, this)
R -> P : bloquear()
note right of P : EJECUTANDO -> BLOQUEADO\nconserva la memoria
R -> PL : liberarCpu()
R -> PL : agregarBloqueado(p)
R --> PL : ResultadoTick(cambiosDeContexto = 1)
PL --> S : ResultadoTick
S -> MT : registrarTick(resultado)

== Ticks siguientes: fase 2 ==
Test -> S : avanzarTick()
S -> PL : actualizarBloqueados()
PL -> P : avanzarBloqueo()
P --> PL : true cuando llega a 0
PL -> P : desbloquear()
note right of P : BLOQUEADO -> LISTO
PL -> PL : encolar(p)
note right of PL : al final de la cola;\npuede despacharse en este mismo tick
@enduml
